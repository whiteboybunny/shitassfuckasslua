local function getThemeColor(name)
    for _, t in ipairs(Themes) do
        if t[1] == name then return t[2] end
    end
    return Themes[1][2]
end

local BASE_ACCENT = getThemeColor(Settings.Theme) -- the color the library is created with
local lastApplied = BASE_ACCENT

local function getContainers()
    local list = {}
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then table.insert(list, hui) end
    table.insert(list, CoreGui)
    local pg = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pg then table.insert(list, pg) end
    return list
end

local function snapshot()
    local set = {}
    for _, c in ipairs(getContainers()) do
        local ok, kids = pcall(function() return c:GetChildren() end)
        if ok then
            for _, k in ipairs(kids) do set[k] = true end
        end
    end
    return set
end

