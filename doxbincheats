local function near(a, b)
    return math.abs(a.R - b.R) < 0.02 and math.abs(a.G - b.G) < 0.02 and math.abs(a.B - b.B) < 0.02
end

local propCache = setmetatable({}, { __mode = "k" })
local function colorProps(inst)
    local cached = propCache[inst]
    if cached then return cached end
    local p = {}
    if inst:IsA("GuiObject") then
        table.insert(p, "BackgroundColor3")
        table.insert(p, "BorderColor3")
    end
    if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        table.insert(p, "TextColor3")
    end
    if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
        table.insert(p, "ImageColor3")
    end
    if inst:IsA("ScrollingFrame") then
        table.insert(p, "ScrollBarImageColor3")
    end
    if inst:IsA("UIStroke") then
        table.insert(p, "Color")
    end
    propCache[inst] = p
    return p
end

local function recolor(color)
    if #GuiRoots == 0 then findRoots() end
    for _, root in ipairs(GuiRoots) do
        if root.Parent then
            for _, d in ipairs(root:GetDescendants()) do
                for _, prop in ipairs(colorProps(d)) do
                    local ok, v = pcall(function() return d[prop] end)
                    if ok and typeof(v) == "Color3" and v ~= color
                        and (near(v, BASE_ACCENT) or near(v, lastApplied)) then
                        pcall(function() d[prop] = color end)
                    end
                end
            end
        end
    end
    lastApplied = color
end

local rainbowConnection
local function setRainbow(state)
    if rainbowConnection then
        rainbowConnection:Disconnect()
        rainbowConnection = nil
    end
    if state then
        local acc = 0
        rainbowConnection = RunService.Heartbeat:Connect(function(dt)
            acc += dt
            if acc < 0.1 then return end
            acc = 0
            recolor(Color3.fromHSV((tick() * 0.12) % 1, 0.85, 1))
        end)
    else
        recolor(getThemeColor(Settings.Theme))
    end
end

task.spawn(function()
    while alive do
        task.wait(0.4)
        if not rainbowConnection and lastApplied ~= BASE_ACCENT then
            recolor(lastApplied)
        end
    end
end)

local function applyHumanoidStats()
    if not humanoid then return end
    humanoid.UseJumpPower = true
    humanoid.WalkSpeed = WalkSpeed
    humanoid.JumpPower = JumpPower
end

local function hookGodmode()
    if godConnection then godConnection:Disconnect() godConnection = nil end
    if not (Godmode and humanoid) then return end
    humanoid.MaxHealth = math.huge
    humanoid.Health = math.huge
    godConnection = humanoid.HealthChanged:Connect(function()
        if Godmode and humanoid.Health < humanoid.MaxHealth then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
end

local function getCharacter()
    character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    humanoid = character:WaitForChild("Humanoid")
    hrp = character:WaitForChild("HumanoidRootPart")
    applyHumanoidStats()
end

track(LocalPlayer.CharacterAdded:Connect(function()
    local wasFlying = FlyEnabled
    stopFly()
    table.clear(noclipParts)
    task.wait(0.5)
    getCharacter()
    hookGodmode()
    if wasFlying then startFly() end
end))

getCharacter()

track(RunService.Heartbeat:Connect(function()
    if humanoid and humanoid.Parent and not FlyEnabled then
        if humanoid.WalkSpeed ~= WalkSpeed then humanoid.WalkSpeed = WalkSpeed end
        if humanoid.JumpPower ~= JumpPower then humanoid.JumpPower = JumpPower end
    end
end))

setNoClip = function(state)
    NoClip = state
    if noclipConnection then
        noclipConnection:Disconnect()
        noclipConnection = nil
    end
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            if not character then return end
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") and part.CanCollide then
                    noclipParts[part] = true
                    part.CanCollide = false
                end
            end
        end)
    else
        for part in pairs(noclipParts) do
            if part.Parent then part.CanCollide = true end
        end
        table.clear(noclipParts)
    end
end

