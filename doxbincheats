-- Crosshair editor: entirely local overlay.
local crosshairEnabled = false
local crosshairGui
local crosshairLines = {}
local crosshairSize = 8
local crosshairGap = 5
local crosshairThickness = 2
local crosshairColor = Color3.fromRGB(255, 255, 255)

local function removeCrosshair()
    if crosshairGui then crosshairGui:Destroy() end
    crosshairGui = nil
    table.clear(crosshairLines)
end

local function refreshCrosshair()
    if not crosshairEnabled then return end
    removeCrosshair()
    local gui = Instance.new("ScreenGui")
    gui.Name = "DoxbinCrosshair"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1000
    gui.Parent = getHudParent()
    crosshairGui = gui

    local function makeLine(name, size, position)
        local line = Instance.new("Frame")
        line.Name = name
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.Size = size
        line.Position = position
        line.BackgroundColor3 = crosshairColor
        line.BorderSizePixel = 0
        line.Parent = gui
        crosshairLines[name] = line
    end

    local cx, cy = 0.5, 0.5
    makeLine("Top", UDim2.fromOffset(crosshairThickness, crosshairSize),
        UDim2.new(cx, 0, cy, -(crosshairGap + crosshairSize / 2)))
    makeLine("Bottom", UDim2.fromOffset(crosshairThickness, crosshairSize),
        UDim2.new(cx, 0, cy, crosshairGap + crosshairSize / 2))
    makeLine("Left", UDim2.fromOffset(crosshairSize, crosshairThickness),
        UDim2.new(cx, -(crosshairGap + crosshairSize / 2), cy, 0))
    makeLine("Right", UDim2.fromOffset(crosshairSize, crosshairThickness),
        UDim2.new(cx, crosshairGap + crosshairSize / 2, cy, 0))
end

CrosshairGroup:CreateToggle("Enable Custom Crosshair", function(state)
    crosshairEnabled = state
    if state then refreshCrosshair() else removeCrosshair() end
end)

CrosshairGroup:CreateSlider("Size", 2, 24, crosshairSize, function(value)
    crosshairSize = value
    refreshCrosshair()
end)

CrosshairGroup:CreateSlider("Gap", 0, 24, crosshairGap, function(value)
    crosshairGap = value
    refreshCrosshair()
end)

CrosshairGroup:CreateSlider("Thickness", 1, 6, crosshairThickness, function(value)
    crosshairThickness = value
    refreshCrosshair()
