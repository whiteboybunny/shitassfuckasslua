end)

local function applyHumanoidStats()
    if not humanoid then return end
    humanoid.UseJumpPower = true
    humanoid.WalkSpeed = WalkSpeed
    humanoid.JumpPower = JumpPower
end

local function hookGodmode()
    if godConnection then godConnection:Disconnect() godConnection = nil end
    if not (Godmode and humanoid) then return end
    humanoid.MaxHealth = math.huge
    humanoid.Health = math.huge
    godConnection = humanoid.HealthChanged:Connect(function()
        if Godmode and humanoid.Health < humanoid.MaxHealth then
            humanoid.Health = humanoid.MaxHealth
        end
    end)
end

local function getCharacter()
    character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    humanoid = character:WaitForChild("Humanoid")
    hrp = character:WaitForChild("HumanoidRootPart")
    applyHumanoidStats()
end

