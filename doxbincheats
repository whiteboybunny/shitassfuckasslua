local function getPingText()
    local ok, result = pcall(function()
        return StatsService.Network.ServerStatsItem["Data Ping"]:GetValueString()
    end)
    return ok and tostring(result) or "N/A"
end

local function getHudParent()
    local ok, hui = pcall(function() return gethui and gethui() end)
    if ok and hui then return hui end
    return CoreGui
end

local function buildHud()
    if hudGui then hudGui:Destroy() end
    hudGui = Instance.new("ScreenGui")
    hudGui.Name = "DoxbinExtrasHUD"
    hudGui.ResetOnSpawn = false
    hudGui.IgnoreGuiInset = true
    hudGui.DisplayOrder = 999
    hudGui.Parent = getHudParent()

    hudLabel = Instance.new("TextLabel")
    hudLabel.Name = "Readout"
    hudLabel.AnchorPoint = Vector2.new(1, 0)
    hudLabel.Position = UDim2.new(1, -16, 0, 16)
    hudLabel.Size = UDim2.fromOffset(210, 92)
    hudLabel.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    hudLabel.BackgroundTransparency = 0.18
    hudLabel.BorderSizePixel = 0
    hudLabel.Font = Enum.Font.GothamSemibold
    hudLabel.TextSize = 13
    hudLabel.TextColor3 = Color3.fromRGB(245, 245, 245)
    hudLabel.TextXAlignment = Enum.TextXAlignment.Left
    hudLabel.TextYAlignment = Enum.TextYAlignment.Top
    hudLabel.TextWrapped = true
    hudLabel.Parent = hudGui

    local padding = Instance.new("UIPadding")
    padding.PaddingTop = UDim.new(0, 9)
    padding.PaddingLeft = UDim.new(0, 10)
    padding.Parent = hudLabel

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 7)
    corner.Parent = hudLabel
end

local function updateHudText()
    if not hudEnabled or not hudLabel then return end
    local rows = {}
    if hudFps then table.insert(rows, "FPS: " .. tostring(currentFPS)) end
    if hudPing then table.insert(rows, "Ping: " .. getPingText()) end
    if hudClock then table.insert(rows, "Time: " .. os.date("%H:%M:%S")) end
    if hudSession then
        local elapsed = math.max(0, math.floor(tick() - sessionStarted))
        local mins = math.floor(elapsed / 60)
        local secs = elapsed % 60
        table.insert(rows, string.format("Session: %02d:%02d", mins, secs))
    end
    hudLabel.Text = #rows > 0 and table.concat(rows, "\n") or "HUD enabled"
    hudLabel.Size = UDim2.fromOffset(210, math.max(34, 12 + (#rows * 19)))
end

HudGroup:CreateToggle("Enable Performance HUD", function(state)
