local function near(a, b)
    return math.abs(a.R - b.R) < 0.02 and math.abs(a.G - b.G) < 0.02 and math.abs(a.B - b.B) < 0.02
end

local propCache = setmetatable({}, { __mode = "k" })
local function colorProps(inst)
    local cached = propCache[inst]
    if cached then return cached end
    local p = {}
    if inst:IsA("GuiObject") then
        table.insert(p, "BackgroundColor3")
        table.insert(p, "BorderColor3")
    end
    if inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox") then
        table.insert(p, "TextColor3")
    end
    if inst:IsA("ImageLabel") or inst:IsA("ImageButton") then
        table.insert(p, "ImageColor3")
    end
    if inst:IsA("ScrollingFrame") then
        table.insert(p, "ScrollBarImageColor3")
    end
    if inst:IsA("UIStroke") then
        table.insert(p, "Color")
    end
    propCache[inst] = p
    return p
end

local function recolor(color)
    if #GuiRoots == 0 then findRoots() end
    for _, root in ipairs(GuiRoots) do
        if root.Parent then
            for _, d in ipairs(root:GetDescendants()) do
                for _, prop in ipairs(colorProps(d)) do
                    local ok, v = pcall(function() return d[prop] end)
                    if ok and typeof(v) == "Color3" and v ~= color
                        and (near(v, BASE_ACCENT) or near(v, lastApplied)) then
                        pcall(function() d[prop] = color end)
                    end
                end
            end
        end
    end
    lastApplied = color
end

local rainbowConnection
local function setRainbow(state)
    if rainbowConnection then
        rainbowConnection:Disconnect()
        rainbowConnection = nil
    end
    if state then
        local acc = 0
        rainbowConnection = RunService.Heartbeat:Connect(function(dt)
            acc += dt
            if acc < 0.1 then return end
            acc = 0
            recolor(Color3.fromHSV((tick() * 0.12) % 1, 0.85, 1))
        end)
    else
        recolor(getThemeColor(Settings.Theme))
    end
end

task.spawn(function()
