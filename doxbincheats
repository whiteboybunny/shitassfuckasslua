-- A local preview hitmarker; actual hit detection depends on each game's own damage system.
local function showHitmarkerPreview()
    local parent = getHudParent()
    local gui = Instance.new("ScreenGui")
    gui.Name = "DoxbinHitmarkerPreview"
    gui.IgnoreGuiInset = true
    gui.DisplayOrder = 1001
    gui.Parent = parent
    for i = 1, 4 do
        local line = Instance.new("Frame")
        line.AnchorPoint = Vector2.new(0.5, 0.5)
        line.Size = UDim2.fromOffset(2, 13)
        line.Position = UDim2.new(0.5, (i <= 2 and -1 or 1) * (i % 2 == 1 and -7 or 7), 0.5, (i <= 2 and -1 or 1) * 7)
        line.Rotation = (i <= 2) and -45 or 45
        line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        line.BorderSizePixel = 0
        line.Parent = gui
    end
    task.delay(0.35, function()
        if gui then gui:Destroy() end
    end)
end

CrosshairGroup:CreateButton("Preview Hitmarker", showHitmarkerPreview)

